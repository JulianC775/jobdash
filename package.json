{
  "name": "jobdash",
  "private": true,
  "scripts": {
    "start": "concurrently --names \"flask,react\" --prefix-colors \"cyan,magenta\" \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "cd backend && ./venv/bin/flask run --host=127.0.0.1",
    "start:frontend": "cd frontend && npm start"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
